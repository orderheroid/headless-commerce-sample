# Base URL of the OrderHero Headless Commerce API. Keep this default unless OrderHero tells you otherwise.
# Must be https. When left empty, the store uses https://api.orderhero.id/v1.
ORDERHERO_API_URL=https://api.orderhero.id/v1

# OrderHero secret key (ohsk_live_...). Set its value ONLY in .env.local or in Vercel's env settings.
# This file is committed: leave it empty. Do NOT prefix it with NEXT_PUBLIC_.
ORDERHERO_SECRET_KEY=

# Store address, e.g. https://store.com. Used for the status page links in OrderHero's WhatsApp/email messages.
# Must be https. When empty: on Vercel the project's production domain is used; locally, localhost.
SITE_URL=
