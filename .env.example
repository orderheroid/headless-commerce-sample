# Alamat dasar OrderHero Headless Commerce API. Biarkan bawaan ini kecuali diarahkan lain oleh OrderHero.
# Wajib https. Bila dikosongkan, toko memakai https://api.orderhero.id/v1.
ORDERHERO_API_URL=https://api.orderhero.id/v1

# Kunci secret OrderHero (ohsk_live_...). Isi nilainya HANYA di .env.local atau di pengaturan env Vercel.
# File ini ikut di-commit: biarkan kosong. JANGAN diberi awalan NEXT_PUBLIC_.
ORDERHERO_SECRET_KEY=

# Alamat toko, mis. https://toko.com. Dipakai untuk tautan halaman status di WA/email OrderHero.
# Wajib https. Bila kosong: di Vercel memakai domain produksi project; di lokal memakai localhost.
SITE_URL=
